<window size="190 244" pause="false" lightbox="false">

    <!-- 单页纸背景 + 顶部标题装饰条（布局与原版 minecolonies:gui/windowinfo.xml 一致） -->
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_left.png" size="6 15" pos="44 12"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_center.png" size="90 15" pos="50 12"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_right.png" size="6 15" pos="140 12"/>

    <!-- 翻页容器：pane id 与原版一致（pages/prevPage/nextPage/pageNum），
         AbstractWindowSkeleton 构造时会自动绑定翻页逻辑与按钮显隐 -->
    <switch id="pages" size="150 210" pos="20 14">
        <view size="100% 100%">
            <text id="helpTitle" size="90 11" pos="30 0" textalign="MIDDLE" color="red" label="$(gui.extracityhall.secretary.help.title)"/>
        </view>
    </switch>

    <!-- 左上箭头：第一页时作为退出按钮（prevPage 此时被骨架类隐藏） -->
    <button id="exit" size="18 10" pos="13 13" source="minecolonies:textures/gui/builderhut/turn_page_left.png"/>
    <button id="prevPage" size="18 10" pos="13 13" source="minecolonies:textures/gui/builderhut/turn_page_left.png"/>
    <button id="nextPage" size="18 10" pos="159 13" source="minecolonies:textures/gui/builderhut/turn_page_right.png"/>
    <text id="pageNum" size="20 11" pos="158 222" textalign="MIDDLE" label="" color="black"/>
</window>
