<window size="190 244" pause="false" lightbox="false">

    <!-- 单页纸背景（与原版「所需资源」窗一致的单页风格） -->
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>

    <!-- 顶部居中标题 -->
    <text size="150 11" pos="20 16" textalign="MIDDLE" color="black" label="$(gui.extracityhall.secretary.resources.title)"/>

    <!-- 所需物品清单（图标 + 名称 + 数量） -->
    <list id="neededResources" size="150 190" pos="20 36">
        <view size="100% 17">
            <box size="100% 17" linewidth="0">
                <itemicon id="resourceIcon" size="17 17" pos="0 0"/>
                <label id="resourceName" size="95 12" pos="20 1" color="black" textalign="MIDDLE_LEFT"/>
                <label id="resourceQty" size="30 12" pos="118 1" color="black" textalign="MIDDLE_LEFT"/>
            </box>
        </view>
    </list>
</window>
